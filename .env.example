# secrets template — copy to .env and fill in. NEVER commit a filled .env.
# Source of truth for the real values: %HERMES_HOME%\.env  (on the old machine)
#
# Hermes reads %HERMES_HOME%\.env directly, so these are for anything that
# expects them in the environment (project .venv scripts, git hooks).
#
# cp .env.example .env   then edit. Keep the real .env out of git (.gitignore: .env*)

# --- LLM providers used by config.yaml (interpolated as ${VAR}) ---
QWEN_9ARM_API_KEY=
POLLINATIONS_KEY=

# --- Hermes custom-provider aliases ---
HERMES_CUSTOM_9ARM_GATEWAY_API_KEY=
HERMES_CUSTOM_GEN_POLLINATIONS_AI_API_KEY=

# --- local LLM proxy (TDAI) used by Boom scripts ---
TDAI_LLM_API_KEY=
TDAI_LLM_BASE_URL=
TDAI_LLM_MODEL=

# --- optional ---
# NVIDIA_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENCODE_ZEN_API_KEY=
