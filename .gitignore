.env
.env.*
!.env.example
cache/

# --- agent runtime noise (never source of truth) ---
.venv/
node_modules/
__pycache__/
*.pyc
logs/
audio_cache/
image_cache/
sandboxes/
*.db
*.db-shm
*.db-wal
*.lock
*.log

# --- credentials: never in git ---
# auth.json holds a credential_pool (env var names + sha2 fingerprints, not raw
# keys, but still machine state). sessions/ request dumps DO embed live
# Authorization: Bearer <key> headers — 11 of 12 files as of 2026-10-07.
auth.json
sessions/
.hermes_history

# Hermes skill-hub cache + curator runtime state, written into the live skill root
.agents/skills/.hub/
.agents/skills/.locks/
.agents/skills/.usage.json
.agents/skills/.usage.json.lock
.agents/skills/.curator_state
.curator_backups/
.curator_ledger.jsonl

# --- upstream repos vendored as directories (re-clone, don't vendor) ---
stellium/
power-design/
frontend-slides/
Deep-Research-skills/

# --- big binaries / generated artifacts ---
bin/
.rebuild/
.quarantine/

# --- knowledge corpus: ~1GB of scanned PDFs stays on disk, not in git ---
# Committed instead: the derived indexes under Knowledge/indexes/
Knowledge/Astrology-Database/
Knowledge/Tarot-Database/
Tarot Knowledge/

# --- editor / vault noise ---
.obsidian/workspace*.json
.obsidian/cache/
